# ============================================================
# .htaccess — ПРОДАКШН-ВЕРСИЯ (исправленная)
# HostLand VPS (Apache + Nginx proxy)
# ============================================================

# Включаем движок rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Принудительный редирект с HTTP на HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Кастомные страницы ошибок
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html
ErrorDocument 500 /500.html

# ============================================================
# 1. ЗАЩИТА ЧУВСТВИТЕЛЬНЫХ ФАЙЛОВ
# ============================================================

<FilesMatch "^\.env$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.well-known">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(log|bak|sql|ini|conf|dist|save|orig|tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================================
# 2. БЕЗОПАСНОСТЬ ДИРЕКТОРИЙ
# ============================================================

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteRule ^private_uploads/ - [F,L]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^data/ - [F,L]
    RewriteRule ^sessions/ - [F,L]
</IfModule>

# ============================================================
# 3. ЗАЩИТНЫЕ HTTP-ЗАГОЛОВКИ
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://api-maps.yandex.ru https://yastatic.net https://yandex.ru https://mc.yandex.ru https://mc.yandex.com ; style-src 'self' https://yastatic.net; img-src 'self' data: https://cdn.yandex.ru https://mc.yandex.ru https://mc.yandex.com; font-src 'self' https://yastatic.net; connect-src 'self' https://yastatic.net https://yandex.ru https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.com wss://yandex.ru; frame-src 'self' https://yandex.ru https://mc.yandex.ru https://mc.yandex.com; object-src 'none'; base-uri 'self'; form-action 'self';"
    
    Header always unset X-Powered-By
    Header always unset Server
    
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    
    <FilesMatch "\.(php)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always set X-Accel-Expires "0"
        Header always set X-Cache-Status "BYPASS"
    </FilesMatch>
    
    <FilesMatch "\.(json)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always set X-Accel-Expires "0"
    </FilesMatch>
</IfModule>

# ============================================================
# 4. ЧПУ ДЛЯ СТРАНИЦ И МОДАЛЬНЫХ ОКОН (единый блок)
# ============================================================
<IfModule mod_rewrite.c>
    # ---- ЯВНЫЕ ПРАВИЛА ДЛЯ БАЗОВЫХ СТРАНИЦ (без .html) ----
    RewriteRule ^about$ /about.html [L]
    RewriteRule ^contacts$ /contacts.html [L]
    RewriteRule ^services$ /services.html [L]
    RewriteRule ^projects$ /projects.html [L]
    RewriteRule ^news$ /news.html [L]
    RewriteRule ^docs$ /docs.html [L]
    RewriteRule ^vacancies$ /vacancies.html [L]
    RewriteRule ^partners$ /partners.html [L]
    RewriteRule ^search$ /search.html [L]

    # ---- СПЕЦИАЛЬНЫЕ ПРАВИЛА ДЛЯ МОДАЛЬНЫХ ОКОН (без .html) ----
    # /feedback и /proposal → index.html (это модальные окна на главной)
    RewriteRule ^feedback$ /index.html [L]
    RewriteRule ^proposal$ /index.html [L]

    # /vacancy/ID → index.html с параметром modal=vacancy
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^vacancy/([^/]+)$ /index.html?modal=vacancy&id=$1 [L,QSA]

    # ---- ДЕТАЛЬНЫЕ МОДАЛЬНЫЕ URL (с параметрами) ----
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^news/([^/]+)$ /news.html?modal=news&id=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^projects/([^/]+)$ /projects.html?modal=project&id=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^category/([^/]+)$ /news.html?modal=category&id=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^project-category/([^/]+)$ /projects.html?modal=project-category&id=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^policy/(.+)$ /index.html?modal=policy&key=$1 [L,QSA]

    # ---- ОБЩЕЕ ПРАВИЛО ДЛЯ ВСЕХ ОСТАЛЬНЫХ ПУТЕЙ ----
    # Если файл не существует, пытаемся добавить .html
    # (для обычных страниц, которых нет в явных правилах)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# ============================================================
# 5. ОГРАНИЧЕНИЕ РАЗМЕРА ЗАПРОСА
# ============================================================
LimitRequestBody 35000000

# ============================================================
# 6. СЖАТИЕ
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/font-woff application/font-woff2
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|zip|gz|br)$ no-gzip dont-vary
</IfModule>

# ============================================================
# 7. КЭШИРОВАНИЕ СТАТИКИ
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set X-Accel-Expires "0"
    </FilesMatch>

    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set X-Accel-Expires "0"
        Header set X-Cache-Status "BYPASS"
    </FilesMatch>
</IfModule>

# ============================================================
# 8. ЗАЩИТА ОТ ГОРЯЧИХ ССЫЛОК (Hotlinking)
# ============================================================
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?normacode\.ru [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?vdengineering\.ru [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?localhost [NC]
    RewriteRule \.(jpg|jpeg|png|gif|svg|webp)$ - [F,NC,L]
</IfModule>

# ============================================================
# 9. ЗАЩИТА ОТ СПАМ-БОТОВ
# ============================================================
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} (havij|libwww-perl|wget|python|nikto|scan|java|winhttp|HTTrack|clshttp|archiver|loader|email|harvest|extract|grab|miner) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ^$
    RewriteRule ^ - [F,L]
</IfModule>

# ============================================================
# 10. ДОПОЛНИТЕЛЬНАЯ ЗАЩИТА
# ============================================================
<IfModule mod_rewrite.c>
    RewriteRule ^private_uploads/.*\.php$ - [F,L]
</IfModule>